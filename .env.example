# BuyWiz Environment Variables
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Gmail Configuration for Email Notifications
GMAIL_USER_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Email Validation API
ABSTRACT_KEY=your-abstract-api-key

# Web Scraping - BrightData Proxy (Optional)
# If not provided, scraping will use direct connections without proxy
BRIGHT_DATA_USERNAME=your-bright-data-username
BRIGHT_DATA_PASSWORD=your-bright-data-password

# Chromium Path (Optional for Docker deployments)
# Default: /usr/bin/chromium
CHROMIUM_PATH=/usr/bin/chromium

# SerpAPI for Google Shopping (if used)
SERPAPI_KEY=your-serpapi-key

# Node Environment
NODE_ENV=production

# Port (optional, defaults to 3000)
PORT=3000
